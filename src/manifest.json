    "data/weapons.js",
    "weapons/viewmodels.js",
    "weapons/arsenal.js",
    "render/fx.js",
    "weapons/grenades.js",
    "core/audio.js",
    "core/announcer.js",
    "game/state.js",
    "weapons/firing.js",
    "core/input.js",
    "core/gamepad.js",
    "game/deploy.js",
    "game/modes.js",
    "net/messages.js",
