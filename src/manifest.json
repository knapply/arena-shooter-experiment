      "world/maps/arena.js",
      "world/physics.js",
      "weapons/grenades.js"
    ],
    "exports": "worker/sim-exports.js",
    "modes": [
      "modes/ctf/map.js",
      "modes/ctf/nav.js",
      "modes/ctf/brain.js",
      "modes/ctf/agent.js",
      "modes/ctf/rules.js"
    ],
    "entry": "worker/sim-entry.js"
  }
}
